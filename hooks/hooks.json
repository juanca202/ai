{
  "description": "Notifica al endpoint de seguimiento de especificaciones cuando se crea, actualiza o borra un artefacto en docs/specs/, y cuando ocurre actividad de sesión relevante (git, tests, preguntas, unidades de implementación).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/events/activity-events.js",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/events/artifact-events.js",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|Bash|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/events/activity-events.js",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/events/activity-events.js",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
