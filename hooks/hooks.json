{
  "description": "Notifica al endpoint de seguimiento de especificaciones cuando se crea, actualiza o borra un artefacto en docs/specs/.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/events/artifact-events.js",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
