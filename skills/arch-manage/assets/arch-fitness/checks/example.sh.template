#!/usr/bin/env sh
# =============================================================================
# Fitness function — {{<estándar>/CR-XXX}}: {{descripción del criterio}}
# -----------------------------------------------------------------------------
# Wrapper que ejecuta el chequeo de arquitectura que valida este CRITERIO de
# cumplimiento (un CR de un estándar de dominio en docs/standards/). El agrupador
# (../verify.sh) descubre y corre este archivo automáticamente
# junto al resto de validaciones.
#
# Reglas:
#   - Nombre del archivo según el Enfoque del CR:
#       * bloqueante: <estándar>-CR-XXX.sh       (p. ej. testing-CR-001.sh; su fallo tumba el gate)
#       * warning:    <estándar>-CR-XXX.warn.sh  (p. ej. testing-CR-002.warn.sh; su fallo se reporta como WARN)
#     El nombre mapea el resultado a su criterio; el sufijo .warn.sh es lo que el agrupador reconoce.
#   - Debe salir con código 0 si el criterio se cumple, distinto de 0 si se viola.
#   - Invoca la herramienta real de la fitness function (dependency-cruiser,
#     ArchUnit, import-linter, NetArchTest, o un script propio). Si la validación
#     ya vive en otro sitio (p. ej. un test JVM en tests/arch/), este wrapper solo
#     la invoca; no dupliques la lógica.
#   - Crear siempre junto a su pareja de Windows (checks/example.ps1.template),
#     invocando el MISMO comando — ambos wrappers deben quedar sincronizados.
# =============================================================================
set -e

# Sustituir por el comando ACOTADO de la fitness function de este criterio. Ejemplos:
#   exec npx depcruise --config .dependency-cruiser.js src
#   exec mvn -q -Dtest=GraphQlOnlyArchTest test
#   exec lint-imports --config .importlinter
#   exec dotnet test --filter "Category=Architecture"
exec {{comando de la fitness function}}
