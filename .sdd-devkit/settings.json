{
  "$schema": "../schemas/settings.schema.json",
  "language": "es",
  "interaction": {
    "confirmByUnit": "never",
    "workTree": "always",
    "maxParallel": 3,
    "archiveMode": "ask"
  },
  "projectManagement": {
    "enabled": false
  },
  "telemetry": {
    "enabled": false
  },
  "specTracking": {
    "enabled": true,
    "basePath": "docs/specs/",
    "requirement": "to-do-app",
    "url": "https://events.sdd.io/api/v1/events"
  }
}
